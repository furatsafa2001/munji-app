{
  "name": "munji-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MUNJI backend: Firestore and Storage rules, Cloud Functions, emulator tooling",
  "scripts": {
    "emu": "firebase emulators:start",
    "seed": "node seed/seed.js",
    "test": "jest --runInBand",
    "test:rules": "firebase emulators:exec --only auth,firestore,storage \"jest --runInBand\"",
    "test:accounts": "jest tests/accounts.test.js --runInBand",
    "test:functions": "npm --prefix functions test",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy:functions": "firebase deploy --only functions"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-admin": "^12.1.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "firebase": "^10.12.0"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/functions/"
    ]
  }
}
