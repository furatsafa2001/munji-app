rules_version = '2';

// MUNJI — Firestore security rules (month 2: patient data under users/{uid})
//
// Principle: you read what is yours or what you are linked to, you write
// your own settings and what your phone measures, and everything with
// clinical meaning is written by the backend only.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userData(u) {
      return get(/databases/$(database)/documents/users/$(u)).data;
    }

    // caregiverIds is denormalised onto the patient document so rules can
    // check the relationship without a query. Written by functions only.
    function caregiversOf(patientId) {
      return userData(patientId).get('patient', {}).get('caregiverIds', []);
    }

    function isPatient(patientId) {
      return signedIn() && uid() == patientId;
    }

    // Revoking removes the uid from caregiverIds, so access ends on the
    // next request for every path below at once.
    function isLinkedCaregiver(patientId) {
      return signedIn() && uid() in caregiversOf(patientId);
    }

    function canRead(patientId) {
      return isPatient(patientId) || isLinkedCaregiver(patientId);
    }

    function canManageAlarms(patientId) {
      return canRead(patientId);
    }

    function unchanged(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == resource.data[field];
    }

    // optional number: absent, null, or inside [lo, hi]
    function optNum(d, k, lo, hi) {
      return !(k in d) || d[k] == null || (d[k] is number && d[k] >= lo && d[k] <= hi);
    }

    // optional bool: absent, null, or a bool
    function optBool(d, k) {
      return !(k in d) || d[k] == null || d[k] is bool;
    }

    // absent, null, or a number within [lo, hi]
    function optNumIn(d, k, lo, hi) {
      return !(k in d) || d[k] == null
             || (d[k] is number && d[k] >= lo && d[k] <= hi);
    }

    function minutes(v) {
      return v is int && v >= 0 && v <= 60;
    }

    // ------------------------------------------------------------ users

    match /users/{userId} {

      // Only these top-level fields may exist. `disabled` is listed because
      // the server sets it; clients may only create it as false and never
      // change it (see create and update below).
      function userShapeValid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['role', 'fullName', 'phone', 'email', 'locale',
                                 'fcmTokens', 'createdAt', 'disabled',
                                 'devicePaired', 'patient', 'caregiver'])
               && optBool(d, 'devicePaired')
               && d.role in ['patient', 'caregiver']
               && d.fullName is string && d.fullName.size() > 0
               && d.fullName.size() <= 100
               && d.phone is string && d.phone.matches('^\\+[0-9]{8,15}$')
               && d.email is string
               && d.locale in ['ar', 'en']
               && d.fcmTokens is list
               && d.createdAt is timestamp;
      }

      // only linkCode_redeem and link_revoke may change the relationship
      function linksUntouched() {
        return request.resource.data.get('patient', {}).get('caregiverIds', [])
                 == resource.data.get('patient', {}).get('caregiverIds', [])
               && request.resource.data.get('caregiver', {}).get('patientIds', [])
                 == resource.data.get('caregiver', {}).get('patientIds', []);
      }

      allow read: if isPatient(userId) || isLinkedCaregiver(userId);

      allow create: if signedIn()
                    && uid() == userId
                    && userShapeValid()
                    && request.resource.data.get('disabled', false) == false
                    && request.resource.data.get('patient', {}).get('caregiverIds', []).size() == 0
                    && request.resource.data.get('caregiver', {}).get('patientIds', []).size() == 0;

      allow update: if signedIn()
                    && uid() == userId
                    && userShapeValid()
                    && unchanged('role')
                    && unchanged('createdAt')
                    && request.resource.data.get('disabled', false)
                         == resource.data.get('disabled', false)    // server only
                    && linksUntouched();

      allow delete: if false;                // account deletion function only

      // ----------------------------------------------- device/current
      //
      // One document per patient. A new pairing overwrites it, so two
      // active devices for one patient cannot exist.

      match /device/{docId} {

        function deviceValid() {
          let d = request.resource.data;
          return docId == 'current'
                 && d.keys().hasOnly(['status', 'serial', 'model', 'firmware', 'pairedAt',
                                      'connected', 'charging', 'worn', 'battery', 'lastSeenAt',
                                      'hr', 'rmssd', 'stabilizing'])
                 && d.keys().hasAll(['status', 'serial', 'model', 'pairedAt',
                                     'connected', 'battery', 'lastSeenAt'])
                 && d.status in ['paired', 'unpaired']
                 && d.serial is string && d.serial.size() > 0 && d.serial.size() <= 64
                 && d.model is string && d.model.size() <= 32
                 && (!('firmware' in d) || d.firmware == null
                     || (d.firmware is string && d.firmware.size() <= 32))
                 && d.pairedAt is timestamp
                 && d.connected is bool
                 && optBool(d, 'charging')
                 && optBool(d, 'worn')
                 && optBool(d, 'stabilizing')
                 && d.battery is int && d.battery >= 0 && d.battery <= 100
                 // latest reading for the caregiver, null when not fresh
                 && optNumIn(d, 'hr', 20, 300)
                 && optNumIn(d, 'rmssd', 0, 1000)
                 && d.lastSeenAt == request.time;      // server clock, not the phone's
        }

        allow read: if canRead(userId);

        allow create: if isPatient(userId)
                      && deviceValid()
                      && request.resource.data.pairedAt == request.time;

        // pairedAt moves only when a different device is paired
        allow update: if isPatient(userId)
                      && deviceValid()
                      && ((request.resource.data.serial == resource.data.serial
                           && request.resource.data.pairedAt == resource.data.pairedAt)
                          || (request.resource.data.serial != resource.data.serial
                           && request.resource.data.pairedAt == request.time));

        allow delete: if false;
      }

      // --------------------------------------------------- recordings
      //
      // Created by the storage finalize trigger after the file passes
      // validation, so a record never exists without its data. The patient
      // may only toggle `saved`; unsaved recordings expire after 90 days.

      match /recordings/{recordingId} {
        allow read: if canRead(userId);

        allow update: if isPatient(userId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saved'])
                      && request.resource.data.saved is bool;

        // deleting goes through the file: the patient deletes the .ecg and
        // a trigger removes this document
        allow create, delete: if false;
      }

      // ------------------------------------------------------- events
      //
      // A client that could write events could fabricate an emergency or
      // hide a real one. Server only.

      match /events/{eventId} {
        allow read: if canRead(userId);
        allow write: if false;
      }

      // ------------------------------------------------------- hourly
      //
      // Written by the phone once per finished hour. The id is the hour in
      // Riyadh time (yyyyMMddHH), so the same hour cannot be uploaded twice.

      match /hourly/{hourId} {

        function hourValid() {
          let d = request.resource.data;
          let r = d.hourStart + duration.value(3, 'h');    // Asia/Riyadh, no DST
          return hourId.matches('^[0-9]{10}$')
                 && d.keys().hasOnly(['hourStart', 'dayKey', 'hrAvg', 'hrMin', 'hrMax',
                                      'hrvAvg', 'qualityPct', 'monitoredMin', 'leadOffMin',
                                      'chargingMin', 'disconnectedMin', 'expireAt', 'createdAt'])
                 && d.keys().hasAll(['hourStart', 'dayKey', 'monitoredMin', 'leadOffMin',
                                     'chargingMin', 'disconnectedMin', 'expireAt', 'createdAt'])
                 && d.hourStart is timestamp
                 && d.hourStart.minutes() == 0
                 && d.hourStart.seconds() == 0
                 && d.hourStart.nanos() == 0
                 && int(hourId[0:4]) == r.year()
                 && int(hourId[4:6]) == r.month()
                 && int(hourId[6:8]) == r.day()
                 && int(hourId[8:10]) == r.hours()
                 && d.dayKey == hourId[0:8]
                 && d.hourStart + duration.value(1, 'h') <= request.time     // hour finished
                 && d.expireAt == d.hourStart + duration.value(90, 'd')
                 && d.createdAt == request.time
                 && optNum(d, 'hrAvg', 20, 300)
                 && optNum(d, 'hrMin', 20, 300)
                 && optNum(d, 'hrMax', 20, 300)
                 && optNum(d, 'hrvAvg', 0, 2000)
                 && optNum(d, 'qualityPct', 0, 100)
                 && minutes(d.monitoredMin)
                 && minutes(d.leadOffMin)
                 && minutes(d.chargingMin)
                 && minutes(d.disconnectedMin)
                 && d.monitoredMin + d.leadOffMin + d.chargingMin + d.disconnectedMin <= 60;
        }

        allow read: if canRead(userId);
        allow create: if isPatient(userId) && hourValid();
        allow update, delete: if false;                  // TTL removes them
      }

      // -------------------------------------------------------- daily
      //
      // Recomputed by a trigger from the hourly documents.

      match /daily/{dayId} {
        allow read: if canRead(userId);
        allow write: if false;
      }
    }

    // -------------------------------------------------------- careLinks

    match /careLinks/{linkId} {
      allow read: if signedIn()
                  && (uid() == resource.data.patientId || uid() == resource.data.caregiverId);
      allow write: if false;                 // linkCode_redeem / link_revoke only
    }

    // -------------------------------------------------------- linkCodes

    match /linkCodes/{code} {
      allow read, write: if false;           // six digits — never client-readable
    }

    match /linkAttempts/{uid} {
      allow read, write: if false;           // redemption rate limit, server only
    }

    // -------------------------------------------------------- medAlarms
    //
    // Out of month 2 scope, unchanged. Document ID is
    // {patientUid}_{normalisedMedName} so a medicine cannot be added twice.

    match /medAlarms/{alarmId} {

      function medShapeValid() {
        let d = request.resource.data;
        return d.patientId is string
               && d.medName is string && d.medName.size() > 0
               && d.medKey is string && d.medKey.size() > 0
               && alarmId == d.patientId + '_' + d.medKey
               && d.timeLocal is string && d.timeLocal.matches('^[0-2][0-9]:[0-5][0-9]$')
               && d.repeatDays is list
               && d.enabled is bool;
      }

      allow read: if canRead(resource.data.patientId);

      allow create: if canManageAlarms(request.resource.data.patientId)
                    && medShapeValid()
                    && request.resource.data.createdBy == uid();

      allow update: if canManageAlarms(resource.data.patientId)
                    && medShapeValid()
                    && unchanged('patientId')
                    && unchanged('medKey')
                    && unchanged('createdBy');

      allow delete: if canManageAlarms(resource.data.patientId);
    }

    // --------------------------------------------------------- auditLog

    match /auditLog/{logId} {
      allow read, write: if false;           // append-only, Admin SDK only
    }

    // ------------------------------------------------- deny by default
    //
    // Covers the retired top-level devices, events, recordings,
    // vitalsDaily and alerts collections.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
